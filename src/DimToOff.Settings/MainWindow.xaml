<Window
    x:Class="DimToOff.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DimToOff.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,4,0,10" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,14,0,2" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CompactToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="Width" Value="48" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
            </Style>

            <Style x:Key="ValueBoxStyle" TargetType="NumberBox">
                <Setter Property="Width" Value="148" />
                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            </Style>

            <Style x:Key="ChoiceStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="196" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            ColumnSpacing="10"
            Padding="16,0,140,0"
            VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                <Grid Width="32" Height="32">
                    <Path
                        Data="M 7.5 8.5 L 24.5 8.5 Q 27 8.5 27 11 L 27 20 Q 27 22.5 24.5 22.5 L 7.5 22.5 Q 5 22.5 5 20 L 5 11 Q 5 8.5 7.5 8.5 Z"
                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                        StrokeThickness="2.6"
                        StrokeLineJoin="Round"
                        Fill="Transparent" />
                    <Path
                        Data="M 16 22.5 L 16 25.5 M 11.5 26 L 20.5 26"
                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                        StrokeThickness="2.4"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Grid>
            </Viewbox>

            <TextBlock
                Grid.Column="1"
                Text="DimToOff"
                FontSize="13"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Grid>

        <NavigationView
            x:Name="SectionNav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="196"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="SectionNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Screen off" Tag="ScreenOff">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Away" Tag="Away">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Advanced" Tag="Advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Padding="8,4,24,28">
                    <StackPanel x:Name="GeneralPanel" Spacing="6" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="General" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock
                            Text="DimToOff blanks the screen without sending the PC to sleep."
                            Style="{StaticResource PageSubtitleStyle}" />

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="StatusBadge"
                                    Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon
                                        x:Name="StatusIcon"
                                        Glyph="&#xE706;"
                                        FontSize="20"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock
                                        x:Name="StatusTitle"
                                        Text="DimToOff is on"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        x:Name="StatusSummary"
                                        FontSize="13"
                                        TextWrapping="WrapWholeWords"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch
                                    x:Name="EnabledToggle"
                                    Grid.Column="2"
                                    Style="{StaticResource CompactToggleStyle}"
                                    VerticalAlignment="Center"
                                    Toggled="Setting_Changed" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Startup and notifications" Style="{StaticResource GroupTitleStyle}" />

                        <controls:SettingRow
                            Glyph="&#xE7E8;"
                            Header="Start with Windows"
                            Description="Runs DimToOff for the current Windows user at sign-in.">
                            <controls:SettingRow.Action>
                                <ToggleSwitch
                                    x:Name="StartWithWindowsToggle"
                                    Style="{StaticResource CompactToggleStyle}"
                                    Toggled="Setting_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            Glyph="&#xE7BA;"
                            Header="Error notifications"
                            Description="Show a tray notification when blanking or restoring fails.">
                            <controls:SettingRow.Action>
                                <ToggleSwitch
                                    x:Name="ErrorNotificationsToggle"
                                    Style="{StaticResource CompactToggleStyle}"
                                    Toggled="Setting_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            Glyph="&#xE895;"
                            Header="Update notifications"
                            Description="Check GitHub Releases once a day and notify when a newer version is out.">
                            <controls:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Content="Check now" Click="CheckUpdatesButton_Click" />
                                    <ToggleSwitch
                                        x:Name="UpdateNotificationsToggle"
                                        Style="{StaticResource CompactToggleStyle}"
                                        Toggled="Setting_Changed" />
                                </StackPanel>
                            </controls:SettingRow.Action>
                        </controls:SettingRow>
                    </StackPanel>

                    <StackPanel
                        x:Name="ScreenOffPanel"
                        Spacing="6"
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                        <TextBlock Text="Screen off" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock
                            Text="How the screen goes dark, and what the brightness keys trigger."
                            Style="{StaticResource PageSubtitleStyle}" />

                        <controls:SettingRow
                            Glyph="&#xE706;"
                            Header="Blank at minimum brightness"
                            Description="Turn brightness all the way down to blank the screen, the way a Mac does.">
                            <controls:SettingRow.Action>
                                <ToggleSwitch
                                    x:Name="BrightnessTriggerToggle"
                                    Style="{StaticResource CompactToggleStyle}"
                                    Toggled="Setting_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            x:Name="OffThresholdRow"
                            Glyph="&#xEC8A;"
                            Header="Off threshold"
                            Description="Brightness at or below this value starts blanking.">
                            <controls:SettingRow.Action>
                                <NumberBox
                                    x:Name="OffThresholdBox"
                                    Style="{StaticResource ValueBoxStyle}"
                                    Minimum="0"
                                    Maximum="10"
                                    SmallChange="1"
                                    ValueChanged="Number_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            Glyph="&#xE7F4;"
                            Header="Blanking method"
                            Description="The overlay keeps Windows awake and unlocked. Monitor power asks Windows to cut the panel.">
                            <controls:SettingRow.Action>
                                <ComboBox
                                    x:Name="DisplayModeCombo"
                                    Style="{StaticResource ChoiceStyle}"
                                    SelectionChanged="Choice_Changed">
                                    <ComboBoxItem Content="Black overlay" Tag="Blackout" />
                                    <ComboBoxItem Content="Monitor power off" Tag="MonitorPower" />
                                </ComboBox>
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <InfoBar
                            x:Name="MonitorPowerInfo"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Warning"
                            Title="Monitor power off behaves differently per laptop"
                            Message="Some machines route the request into lock, sleep, or Modern Standby, and it can affect every connected display. The black overlay is the safe default." />

                        <controls:SettingRow
                            x:Name="FadeRow"
                            Glyph="&#xE81E;"
                            Header="Fade to black"
                            Description="Length of the fade into the black overlay.">
                            <controls:SettingRow.Action>
                                <NumberBox
                                    x:Name="FadeToBlackBox"
                                    Style="{StaticResource ValueBoxStyle}"
                                    Minimum="0"
                                    Maximum="1200"
                                    SmallChange="20"
                                    ValueChanged="Number_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>
                    </StackPanel>

                    <StackPanel
                        x:Name="AwayPanel"
                        Spacing="6"
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                        <TextBlock Text="When you are away" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock
                            Text="DimToOff can take the screen timeout away from Windows and blank the screen itself."
                            Style="{StaticResource PageSubtitleStyle}" />

                        <controls:SettingRow
                            Glyph="&#xE916;"
                            Header="Blank the screen when I am away"
                            Description="Windows stops turning the screen off and stops sleeping on its own. Downloads, playback and background work keep running.">
                            <controls:SettingRow.Action>
                                <ToggleSwitch
                                    x:Name="IdleBlackoutToggle"
                                    Style="{StaticResource CompactToggleStyle}"
                                    Toggled="Setting_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <InfoBar
                            x:Name="IdleTakeoverInfo"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Title="Your Windows power plan is left alone"
                            Message="DimToOff holds the screen timeout and sleep off only while it runs. Quitting the app hands both back to Windows immediately." />

                        <controls:SettingRow
                            x:Name="PluggedInRow"
                            Glyph="&#xE83E;"
                            Header="Plugged in"
                            Description="Idle time before the screen goes black on AC power.">
                            <controls:SettingRow.Action>
                                <ComboBox
                                    x:Name="PluggedInTimeoutCombo"
                                    Style="{StaticResource ChoiceStyle}"
                                    SelectionChanged="Choice_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            x:Name="OnBatteryRow"
                            Glyph="&#xE859;"
                            Header="On battery"
                            Description="Idle time before the screen goes black on battery power.">
                            <controls:SettingRow.Action>
                                <ComboBox
                                    x:Name="OnBatteryTimeoutCombo"
                                    Style="{StaticResource ChoiceStyle}"
                                    SelectionChanged="Choice_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <TextBlock Text="Stand down when" Style="{StaticResource GroupTitleStyle}" />

                        <controls:SettingRow
                            x:Name="FullscreenRow"
                            Glyph="&#xE740;"
                            Header="A fullscreen app is open"
                            Description="Games, presentations and fullscreen video keep the screen on.">
                            <controls:SettingRow.Action>
                                <ToggleSwitch
                                    x:Name="SkipFullscreenToggle"
                                    Style="{StaticResource CompactToggleStyle}"
                                    Toggled="Setting_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            x:Name="AppRequestRow"
                            Glyph="&#xE8B2;"
                            Header="Another app asks to keep the screen on"
                            Description="Media players and meeting apps that request display time are honored.">
                            <controls:SettingRow.Action>
                                <ToggleSwitch
                                    x:Name="RespectAppRequestsToggle"
                                    Style="{StaticResource CompactToggleStyle}"
                                    Toggled="Setting_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            x:Name="ExternalMonitorRow"
                            Glyph="&#xE7F4;"
                            Header="An external monitor is connected"
                            Description="Leaves the Windows screen timeout alone while docked.">
                            <controls:SettingRow.Action>
                                <ToggleSwitch
                                    x:Name="SkipExternalMonitorToggle"
                                    Style="{StaticResource CompactToggleStyle}"
                                    Toggled="Setting_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>
                    </StackPanel>

                    <StackPanel
                        x:Name="AdvancedPanel"
                        Spacing="6"
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                        <TextBlock Text="Advanced" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock
                            Text="Restore behavior and the timings that keep blanking from misfiring."
                            Style="{StaticResource PageSubtitleStyle}" />

                        <TextBlock Text="Brightness" Style="{StaticResource GroupTitleStyle}" />

                        <controls:SettingRow
                            Glyph="&#xE706;"
                            Header="Preserve brightness"
                            Description="Put brightness back when Windows or an OEM utility changes it after a power mode switch.">
                            <controls:SettingRow.Action>
                                <ToggleSwitch
                                    x:Name="PreserveBrightnessToggle"
                                    Style="{StaticResource CompactToggleStyle}"
                                    Toggled="Setting_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            Header="Minimum restore brightness"
                            Description="Waking never restores a level below this.">
                            <controls:SettingRow.Action>
                                <NumberBox
                                    x:Name="MinimumRestoreBox"
                                    Style="{StaticResource ValueBoxStyle}"
                                    Minimum="30"
                                    Maximum="100"
                                    SmallChange="1"
                                    ValueChanged="Number_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            Header="Default restore brightness"
                            Description="Used until DimToOff has learned a stable brightness.">
                            <controls:SettingRow.Action>
                                <NumberBox
                                    x:Name="DefaultRestoreBox"
                                    Style="{StaticResource ValueBoxStyle}"
                                    Minimum="30"
                                    Maximum="100"
                                    SmallChange="1"
                                    ValueChanged="Number_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <TextBlock Text="Timing" Style="{StaticResource GroupTitleStyle}" />

                        <controls:SettingRow
                            Header="Debounce"
                            Description="Wait after the brightness reaches the threshold before blanking.">
                            <controls:SettingRow.Action>
                                <NumberBox
                                    x:Name="DebounceBox"
                                    Style="{StaticResource ValueBoxStyle}"
                                    Minimum="300"
                                    Maximum="2000"
                                    SmallChange="100"
                                    ValueChanged="Number_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            Header="Cooldown"
                            Description="Blocks an immediate second blanking right after waking.">
                            <controls:SettingRow.Action>
                                <NumberBox
                                    x:Name="CooldownBox"
                                    Style="{StaticResource ValueBoxStyle}"
                                    Minimum="1500"
                                    Maximum="5000"
                                    SmallChange="100"
                                    ValueChanged="Number_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            Header="Ignore input after blanking"
                            Description="Filters touchpad and mouse noise in the moment after the screen goes black.">
                            <controls:SettingRow.Action>
                                <NumberBox
                                    x:Name="IgnoreInputBox"
                                    Style="{StaticResource ValueBoxStyle}"
                                    Minimum="300"
                                    Maximum="2000"
                                    SmallChange="100"
                                    ValueChanged="Number_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <controls:SettingRow
                            Header="Brightness save delay"
                            Description="How long a brightness level has to hold still before it is remembered.">
                            <controls:SettingRow.Action>
                                <NumberBox
                                    x:Name="BrightnessStableBox"
                                    Style="{StaticResource ValueBoxStyle}"
                                    Minimum="1000"
                                    Maximum="10000"
                                    SmallChange="250"
                                    ValueChanged="Number_Changed" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <TextBlock Text="Settings file" Style="{StaticResource GroupTitleStyle}" />

                        <controls:SettingRow
                            Glyph="&#xE7A7;"
                            Header="Start over"
                            Description="Puts every setting on this page back to its default value.">
                            <controls:SettingRow.Action>
                                <Button Content="Reset to defaults" Click="ResetButton_Click" />
                            </controls:SettingRow.Action>
                        </controls:SettingRow>

                        <TextBlock
                            x:Name="SettingsPathText"
                            FontSize="12"
                            Margin="2,6,0,0"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="20,12" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Click="GitHubButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                        <TextBlock Text="GitHub" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Click="LogsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Logs" />
                    </StackPanel>
                </Button>

                <StackPanel
                    x:Name="SaveStatusHost"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Opacity="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,6,0">
                    <FontIcon
                        x:Name="SaveStatusIcon"
                        Glyph="&#xE73E;"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        x:Name="SaveStatusText"
                        Text="Saved"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button
                    Grid.Column="3"
                    Content="Close"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
